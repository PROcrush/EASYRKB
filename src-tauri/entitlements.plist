<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    WKWebView compiles JavaScript at runtime. Without these the hardened
    runtime kills the web process on launch, and the window comes up blank.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!--
    Link export binds UDP and TCP sockets and answers players on the local
    network; the client half connects out to them.
  -->
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>

  <!--
    The library lives under ~/Library/Pioneer, and an export writes to a
    removable volume the user picks.
  -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
