{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the Preferences window and the Sync Manager window",
  "windows": [
    "main",
    "preferences",
    "sync",
    "report"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:default",
    "opener:default"
  ]
}
